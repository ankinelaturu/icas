{
  "schemaVersion": "1.0",
  "id": "loan-payoff",
  "name": "Generate Loan Payoff Statement",
  "target": {
    "vendor": "icas-bank",
    "product": "icas-bank"
  },
  "inputs": {
    "loanAccountId": { "type": "string", "required": true }
  },
  "outputs": {
    "totalPayoffAmount": { "type": "money" }
  },
  "steps": [
    {
      "id": "open-lending",
      "preconditions": [{ "type": "textVisible", "value": "Home" }],
      "action": {
        "type": "hover",
        "target": {
          "strategies": [{ "type": "visibleText", "text": "Lending" }]
        }
      },
      "postconditions": []
    }
  ],
  "success": [{ "type": "textVisible", "value": "Payoff Statement" }]
}
