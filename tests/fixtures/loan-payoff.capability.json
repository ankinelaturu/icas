{
  "schemaVersion": "1.0",
  "id": "loan-payoff",
  "name": "Generate Loan Payoff Statement",
  "description": "TEST FIXTURE ONLY: icas-bank locators for replay tests. Not a submission catalog artifact.",
  "target": {
    "vendor": "icas-bank",
    "product": "icas-bank"
  },
  "discoveredOn": {
    "tenant": "icas-bank"
  },
  "inputs": {
    "loanAccountId": {
      "type": "string",
      "required": true,
      "description": "Loan account identifier"
    },
    "payoffDate": {
      "type": "date",
      "required": true,
      "description": "Requested payoff quote date"
    }
  },
  "outputs": {
    "totalPayoffAmount": {
      "type": "money",
      "extract": {
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Total Payoff Amount",
              "xpath": "following-sibling::td[1]"
            }
          ]
        }
      }
    },
    "principalBalance": {
      "type": "money",
      "extract": {
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Principal Balance",
              "xpath": "following-sibling::td[1]"
            }
          ]
        }
      }
    },
    "perDiemInterest": {
      "type": "money",
      "extract": {
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Per Diem Interest",
              "xpath": "following-sibling::td[1]"
            }
          ]
        }
      }
    }
  },
  "steps": [
    {
      "id": "open-lending",
      "preconditions": [
        { "type": "textVisible", "value": "Home" }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            { "type": "roleText", "role": "link", "text": "Lending" },
            { "type": "visibleText", "text": "Lending" }
          ]
        },
        "intent": "Open lending services",
        "risk": "safe"
      },
      "postconditions": [
        { "type": "textVisible", "value": "Lending Services" },
        { "type": "urlMatches", "pattern": "lending.htm" }
      ]
    },
    {
      "id": "open-loan-search",
      "preconditions": [
        {
          "type": "controlPresent",
          "target": {
            "strategies": [
              { "type": "roleText", "role": "link", "text": "Loan Account Inquiry" },
              { "type": "visibleText", "text": "Loan Account Inquiry" }
            ]
          }
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            { "type": "roleText", "role": "link", "text": "Loan Account Inquiry" },
            { "type": "visibleText", "text": "Loan Account Inquiry" }
          ]
        },
        "intent": "Open existing-loan search",
        "risk": "safe"
      },
      "postconditions": [
        { "type": "textVisible", "value": "Search Loan Account" }
      ]
    },
    {
      "id": "enter-loan-account",
      "preconditions": [
        {
          "type": "controlPresent",
          "target": {
            "strategies": [
              { "type": "relative", "text": "LN Acct #" },
              { "type": "css", "selector": "input[name='txtAcct']" }
            ]
          }
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            { "type": "relative", "text": "LN Acct #" },
            { "type": "css", "selector": "input[name='txtAcct']" }
          ]
        },
        "value": { "input": "loanAccountId" },
        "intent": "Enter requested loan account",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "valueEquals",
          "target": {
            "strategies": [
              { "type": "relative", "text": "LN Acct #" },
              { "type": "css", "selector": "input[name='txtAcct']" }
            ]
          },
          "value": { "input": "loanAccountId" }
        }
      ]
    },
    {
      "id": "inquire-loan",
      "preconditions": [
        {
          "type": "controlPresent",
          "target": {
            "strategies": [
              { "type": "roleText", "role": "button", "text": "Inquire" },
              { "type": "visibleText", "text": "Inquire" }
            ]
          }
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            { "type": "roleText", "role": "button", "text": "Inquire" },
            { "type": "visibleText", "text": "Inquire" }
          ]
        },
        "intent": "Submit loan inquiry",
        "risk": "safe"
      },
      "postconditions": [
        { "type": "textVisible", "value": "Loan Details" },
        { "type": "urlMatches", "pattern": "account.htm" }
      ]
    },
    {
      "id": "open-payoff",
      "preconditions": [
        {
          "type": "controlPresent",
          "target": {
            "strategies": [
              { "type": "roleText", "role": "link", "text": "Payoff" },
              { "type": "visibleText", "text": "Payoff" }
            ]
          }
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            { "type": "roleText", "role": "link", "text": "Payoff" },
            { "type": "visibleText", "text": "Payoff" }
          ]
        },
        "intent": "Open payoff quote",
        "risk": "safe"
      },
      "postconditions": [
        { "type": "textVisible", "value": "Payoff Dt" },
        { "type": "urlMatches", "pattern": "payoff.htm" }
      ]
    },
    {
      "id": "enter-payoff-date",
      "preconditions": [
        {
          "type": "controlPresent",
          "target": {
            "strategies": [
              { "type": "relative", "text": "Payoff Dt" },
              { "type": "css", "selector": "input[name='dtPayoff']" }
            ]
          }
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            { "type": "relative", "text": "Payoff Dt" },
            { "type": "css", "selector": "input[name='dtPayoff']" }
          ]
        },
        "value": { "input": "payoffDate" },
        "intent": "Enter requested payoff date",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "valueEquals",
          "target": {
            "strategies": [
              { "type": "relative", "text": "Payoff Dt" },
              { "type": "css", "selector": "input[name='dtPayoff']" }
            ]
          },
          "value": { "input": "payoffDate" }
        }
      ]
    },
    {
      "id": "generate-statement",
      "preconditions": [
        {
          "type": "controlPresent",
          "target": {
            "strategies": [
              { "type": "roleText", "role": "button", "text": "Calculate / Generate" },
              { "type": "visibleText", "text": "Calculate / Generate" }
            ]
          }
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            { "type": "roleText", "role": "button", "text": "Calculate / Generate" },
            { "type": "visibleText", "text": "Calculate / Generate" }
          ]
        },
        "intent": "Generate payoff statement",
        "risk": "safe"
      },
      "postconditions": [
        { "type": "textVisible", "value": "Payoff Statement" }
      ]
    }
  ],
  "success": [
    { "type": "textVisible", "value": "Payoff Statement" }
  ]
}
