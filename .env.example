# Copy to `.env` in the repo root. Do not commit `.env`.
#
# icas-agent, icas-play, and icas-adapt call loadRepoEnv() on start. Empty
# process.env keys are filled from this file (`pnpm --filter … exec` often
# drops keys). A non-empty shell export always wins over `.env`.
#
# LLM sections below: DISCOVERY (`icas-agent discover`), ASSIST
# (`icas-play run --assist`), and ADAPT (`icas-adapt` mismatch patches) are
# independent so you can swap models without sharing one provider. Duplicate
# the same OpenAI values in each until you want them to differ.
#
# Model ids are `provider/model` (for example `openai/gpt-4o` or
# `anthropic/claude-sonnet-4-6`). For a local OpenAI-compatible server
# (Ollama, LM Studio, vLLM), keep `provider` as `openai` and set
# `ICAS_*_LLM_BASE_URL` to that server's `/v1` endpoint. Leave BASE_URL
# empty for hosted OpenAI or Anthropic; those public hosts are implied by
# the provider prefix.

# -----------------------------------------------------------------------------
# Discovery — icas-agent discover (candidate proposer)
# -----------------------------------------------------------------------------
# Screenshot is written for evidence. Default model is vision-capable so
# generate can take image bytes later; today the prompt includes the path
# as text. A text-only local model is fine until then.
ICAS_DISCOVERY_LLM_MODEL=openai/gpt-4o

# Credential for ICAS_DISCOVERY_LLM_MODEL. Hosted OpenAI/Anthropic need a
# real key. Many local OpenAI-compatible servers accept any non-empty token
# (for example `local` or `ollama`). Leave empty only when the server
# requires no auth and ICAS_DISCOVERY_LLM_BASE_URL is set.
ICAS_DISCOVERY_LLM_API_KEY=

# LLM HTTP root, including `/v1`. Empty means the provider's public API.
# This is not the tenant surface URL (`--url`). Examples for local servers:
#   Ollama:     http://127.0.0.1:11434/v1
#   LM Studio:  http://127.0.0.1:1234/v1
#   vLLM:       http://127.0.0.1:8000/v1
ICAS_DISCOVERY_LLM_BASE_URL=

# Sampling temperature, typically 0..2. Lower is more deterministic. Discovery
# ranks branches; 0–0.3 is a reasonable start. Empty means provider default.
ICAS_DISCOVERY_LLM_TEMPERATURE=0

# Top-K: consider only the K most likely next tokens. 0 or empty means the
# provider default (often "off"). Not every hosted API honors this (OpenAI
# chat often ignores it; many local samplers do).
ICAS_DISCOVERY_LLM_TOP_K=

# Top-P (nucleus): sample from the smallest set of tokens whose probability
# mass is at least P. Range 0..1. Empty means provider default. Use this or
# temperature as the main knob; stacking high temperature with high top-p
# makes ranking noisier.
ICAS_DISCOVERY_LLM_TOP_P=

# Cap on generated tokens per propose call (one DFS node). Empty means the
# provider default. Structured JSON output is small; 1024–4096 is enough
# unless the model rambles.
ICAS_DISCOVERY_LLM_MAX_OUTPUT_TOKENS=

# -----------------------------------------------------------------------------
# Assist — icas-play run --assist (repair proposer)
# -----------------------------------------------------------------------------
# One bounded repair at a failed replay step. Strict replay (no --assist)
# ignores this section entirely. Assist does not execute actions; ReplayEngine
# policy-checks and must rejoin the original path.

# Model id for the repair proposer. May match discovery or be a
# cheaper/local text model. Repair currently sends the screenshot as a path
# string, not image bytes, so vision is optional here.
ICAS_ASSIST_LLM_MODEL=openai/gpt-4o

# Credential for ICAS_ASSIST_LLM_MODEL. Same rules as
# ICAS_DISCOVERY_LLM_API_KEY. Duplicate the discovery key until you point
# assist at another provider.
ICAS_ASSIST_LLM_API_KEY=

# LLM HTTP root for assist, including `/v1`. Empty means the provider's
# public API. Independent of ICAS_DISCOVERY_LLM_BASE_URL so assist can hit a
# local box while discovery stays hosted. Not the tenant `--url`.
ICAS_ASSIST_LLM_BASE_URL=

# Sampling temperature for the single repair generate. Prefer 0 so a locator
# repair is as repeatable as possible. Empty means provider default.
ICAS_ASSIST_LLM_TEMPERATURE=0

# Top-K for assist. Same meaning as ICAS_DISCOVERY_LLM_TOP_K. Empty = default.
ICAS_ASSIST_LLM_TOP_K=

# Top-P for assist. Same meaning as ICAS_DISCOVERY_LLM_TOP_P. Empty = default.
ICAS_ASSIST_LLM_TOP_P=

# Cap on generated tokens for one repair proposal. Empty means provider
# default. A RepairProposal is a short JSON object.
ICAS_ASSIST_LLM_MAX_OUTPUT_TOKENS=

# -----------------------------------------------------------------------------
# Adapt — icas-adapt mismatch StepSpecializer
# -----------------------------------------------------------------------------
# One generate after guarded replay misses a single step. Compatible runs
# (header-only `verified` enrollment) ignore this section. Adapt does not
# execute actions; ReplayEngine re-verifies the patched capability with no
# LLM. This is not `--assist` (that prefix never writes an override).

# Model id for the step specializer. Page text is sent as text, not pixels,
# so a local text model is fine. May match discovery or assist.
ICAS_ADAPT_LLM_MODEL=openai/gpt-4o

# Credential for ICAS_ADAPT_LLM_MODEL. Same rules as
# ICAS_DISCOVERY_LLM_API_KEY. Duplicate the discovery key until you point
# adapt at another provider.
ICAS_ADAPT_LLM_API_KEY=

# LLM HTTP root for adapt, including `/v1`. Empty means the provider's
# public API. Independent of discovery/assist BASE_URL so adapt can hit a
# local box while discovery stays hosted. Not the tenant `--url`.
ICAS_ADAPT_LLM_BASE_URL=

# Sampling temperature for the single specialize generate. Prefer 0 so a
# locator synonym is as repeatable as possible. Empty means provider default.
ICAS_ADAPT_LLM_TEMPERATURE=0

# Top-K for adapt. Same meaning as ICAS_DISCOVERY_LLM_TOP_K. Empty = default.
ICAS_ADAPT_LLM_TOP_K=

# Top-P for adapt. Same meaning as ICAS_DISCOVERY_LLM_TOP_P. Empty = default.
ICAS_ADAPT_LLM_TOP_P=

# Cap on generated tokens for one StepOverride. Empty means provider
# default. The JSON object is small.
ICAS_ADAPT_LLM_MAX_OUTPUT_TOKENS=

# -----------------------------------------------------------------------------
# Runtime paths and flags (not LLM)
# -----------------------------------------------------------------------------
# Set to 1 to run the live discovery smoke test (needs a real model key).
# Leave unset in CI.
# ICAS_DISCOVERY_SMOKE=

# Optional prompt-policy markdown. Unset uses the packaged default.
# A relative path is joined to process.cwd() (apps/icas-agent under pnpm filter).
# ICAS_PROMPT_POLICY=

# Catalog root for FileSystemCapabilityRegistry (default ./capabilities).
# ICAS_CAPABILITIES_ROOT=

# Evidence root for discovery / replay / adapt logs (default ./evidence).
# ICAS_EVIDENCE_ROOT=

# Force headless Chromium without passing --headless. Also on when CI=true.
# ICAS_HEADLESS=
