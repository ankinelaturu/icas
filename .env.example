# Discovery / --assist model keys. icas-agent and icas-play load this file
# from the repo root when a key is empty (`pnpm --filter exec` does not
# forward OPENAI_API_KEY into Node). A non-empty shell export still wins.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Mastra model-router id (default openai/gpt-4o, image-capable)
ICAS_MODEL=

# Set to 1 to run the live discovery smoke test
# ICAS_DISCOVERY_SMOKE=

# Optional prompt-policy markdown. Leave unset to use the packaged default.
# A relative path is joined to process.cwd() (apps/icas-agent under pnpm filter).
# ICAS_PROMPT_POLICY=

# Catalog root for FileSystemCapabilityRegistry (default ./capabilities)
# ICAS_CAPABILITIES_ROOT=

# Evidence root (default ./evidence)
# ICAS_EVIDENCE_ROOT=
