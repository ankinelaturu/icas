# Discovery model provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Mastra model-router id (default openai/gpt-4o, image-capable)
ICAS_MODEL=

# Set to 1 to run the live discovery smoke test
# ICAS_DISCOVERY_SMOKE=

# Optional default policy prompt
ICAS_PROMPT_POLICY=./packages/policy/prompts/default-policy.md

# Catalog root for FileSystemCapabilityRegistry (default ./capabilities)
# ICAS_CAPABILITIES_ROOT=

# Evidence root (default ./evidence)
# ICAS_EVIDENCE_ROOT=
