{
  "schemaVersion": "1.0",
  "id": "icas-loan-payoff",
  "name": "icas-loan-payoff",
  "target": {
    "vendor": "icas-bank",
    "product": "icas-bank"
  },
  "discoveredOn": {
    "tenant": "icas-bank"
  },
  "inputs": {
    "loanAccountId": {
      "type": "string",
      "required": true
    },
    "payoffDate": {
      "type": "string",
      "required": true
    }
  },
  "outputs": {},
  "steps": [
    {
      "id": "click-lending-services",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Lending Services"
            }
          ]
        },
        "intent": "navigate to lending services",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Lending Services"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending.htm"
        }
      ]
    },
    {
      "id": "click-loan-account-inquiry",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Lending Services"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Loan Account Inquiry"
            }
          ]
        },
        "intent": "navigate to the Loan Account Inquiry screen to initiate payoff statement process",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Loan Account Inquiry"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ]
    },
    {
      "id": "fill-ln-acct",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Loan Account Inquiry"
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            {
              "type": "label",
              "label": "LN Acct #",
              "confidence": 0.9
            },
            {
              "type": "relative",
              "text": "LN Acct #",
              "confidence": 0.9
            }
          ]
        },
        "value": {
          "input": "loanAccountId"
        },
        "intent": "enter loan account number",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ]
    },
    {
      "id": "click-inquire",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "visibleText",
              "text": "Inquire"
            }
          ]
        },
        "intent": "search for the loan details",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Inquire"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/account.htm"
        }
      ]
    },
    {
      "id": "click-payoff",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Inquire"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "visibleText",
              "text": "Payoff"
            }
          ]
        },
        "intent": "navigate to payoff screen",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Payoff"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    },
    {
      "id": "fill-payoff-dt",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Payoff"
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Payoff Dt"
            }
          ]
        },
        "value": {
          "input": "payoffDate"
        },
        "intent": "enter payoff date",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    },
    {
      "id": "click-calculate-generate",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "button",
              "text": "Calculate / Generate"
            }
          ]
        },
        "intent": "generate payoff statement",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Calculate / Generate"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    }
  ],
  "success": [
    {
      "type": "textVisible",
      "value": "Calculate / Generate"
    }
  ]
}
