{
  "schemaVersion": "1.0",
  "capabilityVersion": "1.0.0",
  "id": "loki-loan-payoff",
  "name": "loki-loan-payoff",
  "target": {
    "vendor": "icas-bank",
    "product": "icas-bank"
  },
  "discoveredOn": {
    "tenant": "icas-bank"
  },
  "inputs": {
    "loanAccountId": {
      "type": "string",
      "required": true
    },
    "payoffDate": {
      "type": "string",
      "required": true
    }
  },
  "outputs": {},
  "steps": [
    {
      "id": "click-member-lending",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Member Lending"
            }
          ]
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending.htm"
        }
      ]
    },
    {
      "id": "click-loan-servicing",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Loan Servicing"
            }
          ]
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ]
    },
    {
      "id": "fill-loan",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Loan #"
            }
          ]
        },
        "value": {
          "input": "loanAccountId"
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ]
    },
    {
      "id": "click-search",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "button",
              "text": "Search"
            }
          ]
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Page displays loan details for loan #987654."
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/account.htm"
        }
      ]
    },
    {
      "id": "click-payoff",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Page displays loan details for loan #987654."
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Payoff"
            }
          ]
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Page navigates to the payoff quote screen for loan #987654."
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    },
    {
      "id": "fill-payoff-dt",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Page navigates to the payoff quote screen for loan #987654."
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Payoff Dt",
              "confidence": 0.9
            }
          ]
        },
        "value": {
          "input": "payoffDate"
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    },
    {
      "id": "click-calculate-generate",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "button",
              "text": "Calculate / Generate"
            }
          ]
        },
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "The payoff statement is generated and displayed."
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    }
  ],
  "success": [
    {
      "type": "textVisible",
      "value": "The payoff statement is generated and displayed."
    }
  ]
}
