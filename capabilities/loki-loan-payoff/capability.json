{
  "schemaVersion": "1.0",
  "id": "loki-loan-payoff",
  "name": "loki-loan-payoff",
  "target": {
    "vendor": "icas-bank",
    "product": "icas-bank"
  },
  "discoveredOn": {
    "tenant": "icas-bank"
  },
  "inputs": {
    "loanAccountId": {
      "type": "string",
      "required": true
    },
    "payoffDate": {
      "type": "string",
      "required": true
    }
  },
  "outputs": {},
  "steps": [
    {
      "id": "click-member-lending",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Member Lending"
            }
          ]
        },
        "intent": "navigate to lending module",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Member Lending"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending.htm"
        }
      ]
    },
    {
      "id": "click-loan-servicing",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Member Lending"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Loan Servicing"
            }
          ]
        },
        "intent": "access loan servicing to issue payoff quotes",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Loan Servicing"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ]
    },
    {
      "id": "fill-loan",
      "preconditions": [
        {
          "type": "textVisible",
          "value": "Loan Servicing"
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Loan #"
            }
          ]
        },
        "value": {
          "input": "loanAccountId"
        },
        "intent": "enter loan number",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ]
    },
    {
      "id": "click-search",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/search.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "button",
              "text": "Search"
            }
          ]
        },
        "intent": "search for loan details",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/account.htm"
        }
      ]
    },
    {
      "id": "click-payoff",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/account.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "link",
              "text": "Payoff"
            }
          ]
        },
        "intent": "navigate to the payoff section",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    },
    {
      "id": "fill-payoff-dt",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ],
      "action": {
        "type": "fill",
        "target": {
          "strategies": [
            {
              "type": "relative",
              "text": "Payoff Dt"
            }
          ]
        },
        "value": {
          "input": "payoffDate"
        },
        "intent": "enter the payoff date for the statement",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    },
    {
      "id": "click-calculate-generate",
      "preconditions": [
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ],
      "action": {
        "type": "click",
        "target": {
          "strategies": [
            {
              "type": "roleText",
              "role": "button",
              "text": "Calculate / Generate"
            }
          ]
        },
        "intent": "initiate calculation and generation of the payoff statement",
        "risk": "safe"
      },
      "postconditions": [
        {
          "type": "textVisible",
          "value": "Calculate / Generate"
        },
        {
          "type": "urlMatches",
          "pattern": "/lending/payoff.htm"
        }
      ]
    }
  ],
  "success": [
    {
      "type": "textVisible",
      "value": "Calculate / Generate"
    }
  ]
}
